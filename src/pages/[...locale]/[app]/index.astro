---
import Layout from "@/layouts/main.astro"
import AppIcon from "@/components/app-icon.astro"
import { Card, CardAction, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
import { locales, localeParam, ui, type Locale } from "@/i18n/ui"
import { getRelativeLocaleUrl } from "astro:i18n"
import { ChevronRight, LifeBuoy, ShieldCheck } from "lucide-react"

export const getStaticPaths = () =>
  locales.flatMap((l) => ui[l].apps.map((app) => ({ params: { locale: localeParam(l), app: app.slug } })))

const locale = Astro.currentLocale as Locale
const t = ui[locale]
const app = t.apps.find((a) => a.slug === Astro.params.app)!
const links = [
  { page: "support", title: t.support, hint: t.supportHint, Icon: LifeBuoy },
  { page: "policy", title: t.privacy, hint: t.privacyHint, Icon: ShieldCheck },
]
---

<Layout title={app.name} description={app.description}>
  <section class="flex flex-col items-center gap-5 text-center sm:flex-row sm:items-start sm:gap-6 sm:text-left">
    <AppIcon slug={app.slug} size={112} />
    <div class="w-full min-w-0 space-y-2">
      <h1 class="text-3xl font-semibold tracking-tight">{app.name}</h1>
      <p class="text-muted-foreground">{app.description}</p>
      <a
        href={app.appStore}
        target="_blank"
        rel="noopener"
        class="mt-3 inline-block rounded-lg outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
      >
        <img src={t.appStoreBadge.src} alt={t.appStore} width={t.appStoreBadge.width} height={48} />
      </a>
    </div>
  </section>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      links.map(({ page, title, hint, Icon }) => (
        <a
          href={getRelativeLocaleUrl(locale, `${app.slug}/${page}`)}
          class="group rounded-xl outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
        >
          <Card className="h-full transition-colors group-hover:bg-muted/50">
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <Icon className="size-4 text-primary" />
                {title}
              </CardTitle>
              <CardDescription>{hint}</CardDescription>
              <CardAction>
                <ChevronRight className="size-4 text-muted-foreground" />
              </CardAction>
            </CardHeader>
          </Card>
        </a>
      ))
    }
  </div>
</Layout>
