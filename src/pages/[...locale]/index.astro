---
import Layout from "@/layouts/main.astro"
import AppIcon from "@/components/app-icon.astro"
import { Card, CardContent } from "@/components/ui/card"
import { locales, localeParam, ui, type Locale } from "@/i18n/ui"
import { getRelativeLocaleUrl } from "astro:i18n"

export const getStaticPaths = () => locales.map((l) => ({ params: { locale: localeParam(l) } }))

const locale = Astro.currentLocale as Locale
const t = ui[locale]
---

<Layout>
  <section class="space-y-2">
    <h1 class="text-3xl font-semibold tracking-tight">Vialive</h1>
    <p class="text-muted-foreground">{t.tagline}</p>
  </section>

  <section class="mt-12 space-y-4">
    <h2 class="text-lg font-medium">{t.appsHeading}</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
      {
        t.apps.map((app) => (
          <a
            href={getRelativeLocaleUrl(locale, app.slug)}
            class="group rounded-xl outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
          >
            <Card className="h-full transition-colors group-hover:bg-muted/50">
              <CardContent className="flex flex-col items-center gap-3 text-center">
                <AppIcon slug={app.slug} size={80} />
                <span class="font-medium">{app.name}</span>
              </CardContent>
            </Card>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
