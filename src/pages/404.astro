---
import Layout from "@/layouts/main.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
---

<!-- GitHub Pages serves dist/404.html with a real 404 status for any missing path. -->
<Layout title="404" localized={false}>
  <div class="flex flex-col items-center gap-4 py-16 text-center">
    <h1 class="text-3xl font-semibold">404</h1>
    <p class="text-muted-foreground">Page not found. · 페이지를 찾을 수 없습니다.</p>
    <div class="flex gap-2">
      <a href="/" class={cn(buttonVariants({ variant: "outline" }))}>Home</a>
      <a href="/ko/" class={cn(buttonVariants({ variant: "outline" }))}>홈</a>
    </div>
  </div>
</Layout>
