---
import DocLayout from "@/layouts/doc.astro"
import ContactCard from "@/components/contact-card.astro"
import { Faq } from "@/components/faq"
import { parseDocId, splitFaq } from "@/lib/docs"
import { ui } from "@/i18n/ui"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const docs = await getCollection("docs")
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const { locale, app: appSlug } = parseDocId(entry.id)
const app = ui[locale].apps.find((a) => a.slug === appSlug)
// Every app's support.md gets the contact card, and its "### question" sections become an accordion,
// which already lists every question, so the page skips the on-this-page card.
const isSupport = entry.id.endsWith("/support")
const faq = isSupport ? splitFaq(entry.rendered?.html ?? "") : undefined
---

<DocLayout title={entry.data.title} description={entry.data.description} headings={faq ? [] : headings}>
  <h1>{entry.data.title}</h1>
  {
    faq ? (
      <>
        {app && <ContactCard appName={app.name} />}
        <Fragment set:html={faq.intro} />
        <Faq client:load items={faq.items} />
      </>
    ) : (
      <Content />
    )
  }
</DocLayout>
