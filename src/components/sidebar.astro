---
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { getSidebar } from "@/lib/docs"
import { ui, type Locale } from "@/i18n/ui"
import { getRelativeLocaleUrl } from "astro:i18n"

const locale = Astro.currentLocale as Locale
const groups = await getSidebar(locale)
---

<nav class="space-y-6">
  {
    groups.map(({ app, docs }) => {
      const links = [
        { href: getRelativeLocaleUrl(locale, app.slug), label: ui[locale].overview },
        ...docs.map((d) => ({ href: `/${d.id}/`, label: d.data.label ?? d.data.title })),
      ]
      return (
        <div>
          <p class="mb-1 px-2.5 text-xs font-medium text-muted-foreground">{app.name}</p>
          <ul class="space-y-0.5">
            {links.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={Astro.url.pathname === l.href ? "page" : undefined}
                  class={cn(
                    buttonVariants({ variant: "ghost", size: "sm" }),
                    "w-full justify-start font-normal aria-[current=page]:bg-muted aria-[current=page]:font-medium"
                  )}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    })
  }
</nav>
